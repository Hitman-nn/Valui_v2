<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.valui</groupId>
        <artifactId>valui-parent</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>valui-common</artifactId>
    <name>Valui :: Common</name>
    <description>
        Shared kernel: domain entities, DTOs, domain events, exceptions, utils.
        Deliberately free of Spring Boot runtime — only jakarta annotations + lombok + mapstruct.
    </description>

    <dependencies>
        <!-- Jakarta annotation APIs only — zero Spring Boot runtime -->
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <!-- JPA annotations for shared entities (API only, no Hibernate runtime) -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
        </dependency>
        <!--
          Hibernate-specific annotations (@JdbcTypeCode etc.) used on shared entities.
          provided = compile-only: Hibernate is already on the runtime classpath via valui-user.
        -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- MapStruct interfaces live here; implementations generated per-module -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>
        <!--
          Avro: schema parsing + generated SpecificRecord classes in valui.events.v1.*.
          Not a Spring runtime dep — pure Java library.
          Generated classes are the migration target for Kafka messages (Phase 2).
        -->
        <dependency>
            <groupId>org.apache.avro</groupId>
            <artifactId>avro</artifactId>
            <version>${avro.version}</version>
        </dependency>
    </dependencies>

    <build>
        <!--
          Include src/main/avro/*.avsc as classpath resources (target path: avro/).
          This makes schemas accessible at runtime for SchemaRegistrationService
          and for tests via ClassLoader.getResourceAsStream("avro/xxx.avsc").
        -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>src/main/avro</directory>
                <targetPath>avro</targetPath>
            </resource>
        </resources>

        <plugins>
            <!--
              Generates Java SpecificRecord classes from .avsc schemas.
              Output: target/generated-sources/avro/ → package valui.events.v1.*
              These classes are separate from existing com.valui.common.kafka records
              and serve as the migration target for Phase 2 (full Avro serialisation).
            -->
            <plugin>
                <groupId>org.apache.avro</groupId>
                <artifactId>avro-maven-plugin</artifactId>
                <version>${avro.version}</version>
                <executions>
                    <execution>
                        <id>generate-avro-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>schema</goal>
                        </goals>
                        <configuration>
                            <sourceDirectory>${project.basedir}/src/main/avro</sourceDirectory>
                            <outputDirectory>${project.build.directory}/generated-sources/avro</outputDirectory>
                            <!-- Use java.lang.String instead of CharSequence/Utf8 for string fields -->
                            <stringType>String</stringType>
                            <!-- Generate getters/setters (needed by KafkaAvroSerializer in Phase 2) -->
                            <createSetters>true</createSetters>
                            <!-- Add @AvroGenerated to generated classes -->
                            <customConversions/>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
