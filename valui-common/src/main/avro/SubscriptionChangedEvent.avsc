{
  "namespace": "com.valui.common.avro",
  "type": "record",
  "name": "SubscriptionChangedEvent",
  "doc": "Published to subscription.events (compacted). Key = userId → last plan state per user.",
  "fields": [
    {"name": "userId",    "type": "string",                         "doc": "UUID — also used as partition key"},
    {"name": "oldPlan",   "type": ["null", "string"], "default": null, "doc": "Previous plan code, null on first activation"},
    {"name": "newPlan",   "type": "string",                         "doc": "New active plan code"},
    {"name": "changedAt", "type": {"type": "long", "logicalType": "timestamp-millis"}, "doc": "Epoch ms"}
  ]
}
