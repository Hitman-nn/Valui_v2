{
  "namespace": "valui.events.v1",
  "type":      "record",
  "name":      "UserNotificationRequest",
  "doc":       "Published to user.notifications.pending. Key = userId for per-user ordering.",
  "fields": [
    {
      "name": "notification_id",
      "type": "string",
      "doc":  "UUID of the NotificationLog row — used for idempotency and status tracking"
    },
    {
      "name": "user_id",
      "type": "string",
      "doc":  "UUID of the target user"
    },
    {
      "name": "telegram_id",
      "type": "long",
      "doc":  "Telegram chat ID for delivery"
    },
    {
      "name": "channel",
      "type": "string",
      "doc":  "NotificationChannel enum name: TELEGRAM | EMAIL | WEBHOOK"
    },
    {
      "name": "message_text",
      "type": "string",
      "doc":  "Fully rendered notification text (may contain Markdown)"
    },
    {
      "name": "event_id",
      "type": ["null", "string"],
      "default": null,
      "doc":  "Source SportEventDetected.event_id for tracing; null for system-generated messages"
    },
    {
      "name": "bookmaker",
      "type": ["null", "string"],
      "default": null,
      "doc":  "BookmakerType enum name (FONBET, XBET, …); null for system-generated messages"
    }
  ]
}
