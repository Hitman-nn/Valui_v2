# ─────────────────────────────────────────────────────────────────────────────
# Valui v2 — local development environment variables
# Copy this file to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Database name created on first start
POSTGRES_DB=valui_db
# Application user (should NOT be the superuser "postgres")
POSTGRES_USER=valui
# Strong password; change before any shared/staging deployment
POSTGRES_PASSWORD=valui_secret
# Host port exposed to your machine (mapped to container 5432)
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
# Must match --requirepass in the redis command and REDIS_HOSTS in redis-commander
REDIS_PASSWORD=redis_secret
# Host port exposed to your machine (mapped to container 6379)
REDIS_PORT=6379

# ── Kafka ─────────────────────────────────────────────────────────────────────
# External listener port — used by host-side producers/consumers (e.g. your IDE)
# Internal apps inside Docker connect via kafka:9092 (no config needed here)
KAFKA_EXTERNAL_PORT=29092

# ── Kafka UI (provectuslabs/kafka-ui) ─────────────────────────────────────────
# Browse topics, consumer groups, messages at http://localhost:<port>
KAFKA_UI_PORT=8090

# ── Redis Commander ───────────────────────────────────────────────────────────
# Browse Redis keys at http://localhost:<port>
REDIS_COMMANDER_PORT=8091

# ── Mailhog ───────────────────────────────────────────────────────────────────
# SMTP port — point your Spring Mail / JavaMailSender here
MAILHOG_SMTP_PORT=1025
# Web UI to inspect caught emails: http://localhost:<port>
MAILHOG_UI_PORT=8025

# ── Proxy (local dev only, if server blocks api.telegram.org) ─────────────────
# Telegram bot proxy — maps to valui.bot.proxy.*
# BOT_PROXY_ENABLED=true
# BOT_PROXY_TYPE=SOCKS5
# BOT_PROXY_HOST=your.proxy.host
# BOT_PROXY_PORT=14232
# BOT_PROXY_USER=
# BOT_PROXY_PASS=

# Parser HTTP proxy — maps to parser.proxy.*
# PROXY_ENABLED=true
# PROXY_HOST=your.proxy.host
# PROXY_PORT=4232
# PROXY_USERNAME=
# PROXY_PASSWORD=