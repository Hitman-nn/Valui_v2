<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.valui</groupId>
        <artifactId>valui-parent</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>valui-bot</artifactId>
    <name>Valui :: Bot</name>
    <description>Telegram bot: command routing, update handling, message dispatch</description>

    <dependencies>
        <dependency>
            <groupId>com.valui</groupId>
            <artifactId>valui-common</artifactId>
        </dependency>
        <!-- User/Subscription services + DTOs needed by bot handlers -->
        <dependency>
            <groupId>com.valui</groupId>
            <artifactId>valui-user</artifactId>
        </dependency>
        <!-- Parser: wizard needs to fetch sports/tournaments per bookmaker -->
        <dependency>
            <groupId>com.valui</groupId>
            <artifactId>valui-parser</artifactId>
        </dependency>
        <!-- Monitor: wizard creates controllers via ControllerService -->
        <dependency>
            <groupId>com.valui</groupId>
            <artifactId>valui-monitor</artifactId>
        </dependency>
        <!-- Betting journal: services + cache used by bot handlers -->
        <dependency>
            <groupId>com.valui</groupId>
            <artifactId>valui-betting</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- telegrambots core — TelegramBotsApi registered manually via TelegramBotConfig -->
        <!--
          jackson-module-jaxb-annotations uses javax.xml.bind (removed in Java 11+).
          telegrambots 6.x uses Jersey 3 (Jakarta namespace), so the old javax module
          is not needed and crashes Hibernate 6.5 on startup (JacksonIntegration clinit).
        -->
        <dependency>
            <groupId>org.telegram</groupId>
            <artifactId>telegrambots</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>com.fasterxml.jackson.module</groupId>
                    <artifactId>jackson-module-jaxb-annotations</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.fasterxml.jackson.jaxrs</groupId>
                    <artifactId>jackson-jaxrs-json-provider</artifactId>
                </exclusion>
                <!-- spring-jcl replaces commons-logging; having both causes the
                     "Standard Commons Logging discovery" noise on stdout at startup -->
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
