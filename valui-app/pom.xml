<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.valui</groupId>
        <artifactId>valui-parent</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>valui-app</artifactId>
    <name>Valui :: App</name>
    <description>Spring Boot entrypoint — assembles all modules into a single executable fat JAR</description>

    <dependencies>
        <!-- ── All feature modules ───────────────────────────────────────── -->
        <dependency>
            <groupId>com.valui</groupId>
            <artifactId>valui-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.valui</groupId>
            <artifactId>valui-bot</artifactId>
        </dependency>
        <dependency>
            <groupId>com.valui</groupId>
            <artifactId>valui-user</artifactId>
        </dependency>
        <dependency>
            <groupId>com.valui</groupId>
            <artifactId>valui-parser</artifactId>
        </dependency>
        <dependency>
            <groupId>com.valui</groupId>
            <artifactId>valui-monitor</artifactId>
        </dependency>
        <dependency>
            <groupId>com.valui</groupId>
            <artifactId>valui-notify</artifactId>
        </dependency>
        <dependency>
            <groupId>com.valui</groupId>
            <artifactId>valui-admin</artifactId>
        </dependency>
        <dependency>
            <groupId>com.valui</groupId>
            <artifactId>valui-betting</artifactId>
        </dependency>

        <!-- Spring Boot core (auto-configuration entrypoint) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- AOP for ScheduledTaskAspect (@Around @Scheduled) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- Kafka — explicit dep for KafkaTopicsConfig (also available transitively via monitor/notify) -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- JSON structured logging for ELK / Loki (prod + docker profiles) -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>8.0</version>
        </dependency>

        <!-- Distributed tracing: adds traceId/spanId to MDC for all HTTP request logs -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-brave</artifactId>
        </dependency>

        <!-- Integration tests use Testcontainers for all infra -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>kafka</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Produces the executable fat JAR -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                    <!-- Generates META-INF/build-info.properties (version, build time) — Spring
                         Boot auto-exposes it as a BuildProperties bean once present on the
                         classpath, which StartupLogger reads for the "which build is this"
                         banner line. -->
                    <execution>
                        <id>build-info</id>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Generates git.properties (commit hash, branch, dirty flag) — Spring Boot
                 auto-exposes it as a GitProperties bean once present on the classpath. Answers
                 "which commit is actually running on prod" without needing SSH + git log. -->
            <plugin>
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
                <version>7.0.0</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>revision</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <generateGitPropertiesFile>true</generateGitPropertiesFile>
                    <includeOnlyProperties>
                        <includeOnlyProperty>^git.commit.id.abbrev$</includeOnlyProperty>
                        <includeOnlyProperty>^git.commit.time$</includeOnlyProperty>
                        <includeOnlyProperty>^git.branch$</includeOnlyProperty>
                        <includeOnlyProperty>^git.dirty$</includeOnlyProperty>
                    </includeOnlyProperties>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>