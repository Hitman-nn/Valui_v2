<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.valui</groupId>
        <artifactId>valui-parent</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>valui-app</artifactId>
    <name>Valui :: App</name>
    <description>Spring Boot entrypoint — assembles all modules into a single executable fat JAR</description>

    <dependencies>
        <!-- ── All feature modules ───────────────────────────────────────── -->
        <dependency>
            <groupId>com.valui</groupId>
            <artifactId>valui-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.valui</groupId>
            <artifactId>valui-bot</artifactId>
        </dependency>
        <dependency>
            <groupId>com.valui</groupId>
            <artifactId>valui-user</artifactId>
        </dependency>
        <dependency>
            <groupId>com.valui</groupId>
            <artifactId>valui-parser</artifactId>
        </dependency>
        <dependency>
            <groupId>com.valui</groupId>
            <artifactId>valui-monitor</artifactId>
        </dependency>
        <dependency>
            <groupId>com.valui</groupId>
            <artifactId>valui-notify</artifactId>
        </dependency>
        <dependency>
            <groupId>com.valui</groupId>
            <artifactId>valui-admin</artifactId>
        </dependency>

        <!-- Spring Boot core (auto-configuration entrypoint) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- JSON structured logging for ELK / Loki (prod + docker profiles) -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>8.0</version>
        </dependency>

        <!-- Integration tests use Testcontainers for all infra -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>kafka</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Produces the executable fat JAR -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>