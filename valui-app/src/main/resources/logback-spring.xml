<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Suppress logback's own startup status messages -->
    <statusListener class="ch.qos.logback.core.status.NopStatusListener"/>

    <!-- ─── Custom converter: [BOT] / [MON] / [PAR] / [USR] colored tags ─── -->
    <conversionRule conversionWord="subsystem"
                    class="com.valui.app.logging.SubsystemConverter"/>
    <!-- Plain (no ANSI) equivalents of %subsystem / %msg — for the rolling file appender,
         which is meant to be grepped/tailed without a terminal (cat, scp'd elsewhere, etc). -->
    <conversionRule conversionWord="subsystemPlain"
                    class="com.valui.app.logging.PlainSubsystemConverter"/>
    <conversionRule conversionWord="plainmsg"
                    class="com.valui.app.logging.PlainMessageConverter"/>
    <conversionRule conversionWord="mdc_ctx"
                    class="com.valui.app.logging.MdcContextConverter"/>

    <springProperty scope="context" name="appName"
                    source="spring.application.name" defaultValue="valui"/>
    <springProperty scope="context" name="activeProfile"
                    source="spring.profiles.active"  defaultValue="default"/>
    <!-- Directory for the rolling FILE appender (prod). Override via LOG_PATH env var;
         defaults to a "logs" folder next to wherever the JVM was launched from. -->
    <springProperty scope="context" name="logPath"
                    source="LOG_PATH" defaultValue="logs"/>

    <!-- ═══════════════════════════════════════════════════════════════════════
         CONSOLE — rich colorized output for local development AND for an attached
         terminal (tmux) in prod — this is what you see live while the app runs.
         Format:
           yyyy-MM-dd HH:mm:ss.SSS  LEVEL  [TAG]  ClassName                ▸  message
           2026-08-09 12:34:56.789  INFO   [BOT]  CommandRouter            ▸  Инициализирован с 15 обработчиками
         ═══════════════════════════════════════════════════════════════════════ -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <withJansi>true</withJansi>
        <encoder>
            <pattern>%white(%d{yyyy-MM-dd HH:mm:ss.SSS})  %highlight(%-5level)  %subsystem  %-30(%cyan(%logger{0}))  %white(▸)  %msg%mdc_ctx%n%rootException{full}</pattern>
        </encoder>
    </appender>

    <!-- ═══════════════════════════════════════════════════════════════════════
         FILE — plain-text rolling log, no ANSI, for prod. Exists alongside CONSOLE
         (not instead of it) specifically so `tmux attach` keeps showing the colorized
         live view unchanged, while a clean, dated, rotated file is always on disk for
         later download/analysis — no more manually redirecting stdout per run.
         Rotates daily or at 200MB, keeps 14 days / 2GB total, gzips old files.
         ═══════════════════════════════════════════════════════════════════════ -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${logPath}/valui-app.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS}  %-5level  %subsystemPlain  %-30(%logger{0})  ▸  %plainmsg%mdc_ctx%n%rootException{full}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${logPath}/valui-app-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>200MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="FILE"/>
        <queueSize>512</queueSize>
        <discardingThreshold>20</discardingThreshold>
        <includeCallerData>false</includeCallerData>
    </appender>

    <!-- ═══════════════════════════════════════════════════════════════════════
         JSON — structured logs for ELK / Loki (prod / docker)
         ═══════════════════════════════════════════════════════════════════════ -->
    <appender name="JSON_STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"app":"${appName}","profile":"${activeProfile}"}</customFields>
            <fieldNames>
                <timestamp>@timestamp</timestamp>
                <version>[ignore]</version>
                <levelValue>[ignore]</levelValue>
            </fieldNames>
            <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                <maxDepthPerCause>20</maxDepthPerCause>
                <shortenedClassNameLength>40</shortenedClassNameLength>
                <rootCauseFirst>true</rootCauseFirst>
            </throwableConverter>
        </encoder>
    </appender>

    <!-- ═══════════════════════════════════════════════════════════════════════
         ASYNC wrappers — non-blocking log dispatch for prod/docker
         discardingThreshold=20: drops TRACE/DEBUG/INFO when queue ≥80% full;
         WARN and ERROR are always kept regardless of queue depth.
         ═══════════════════════════════════════════════════════════════════════ -->
    <appender name="ASYNC_CONSOLE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="CONSOLE"/>
        <queueSize>512</queueSize>
        <discardingThreshold>20</discardingThreshold>
        <includeCallerData>false</includeCallerData>
    </appender>

    <appender name="ASYNC_JSON" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="JSON_STDOUT"/>
        <queueSize>512</queueSize>
        <discardingThreshold>20</discardingThreshold>
        <includeCallerData>false</includeCallerData>
    </appender>

    <!-- ═══════════════════════════════════════════════════════════════════════
         Early-startup noise — логируют до применения springProfile
         ═══════════════════════════════════════════════════════════════════════ -->
    <logger name="org.apache.catalina"        level="WARN"/>
    <logger name="org.apache.coyote"          level="WARN"/>
    <logger name="org.apache.tomcat"          level="WARN"/>
    <logger name="com.zaxxer.hikari"          level="WARN"/>
    <logger name="org.hibernate"              level="WARN"/>

    <!-- ═══════════════════════════════════════════════════════════════════════
         Kafka internals — подавляем rebalance/offset шум при любом профиле
         ═══════════════════════════════════════════════════════════════════════ -->
    <!-- Kafka consumer internals: ConsumerCoordinator, SubscriptionState,
         ConsumerUtils, ConsumerRebalanceListenerInvoker и др. -->
    <logger name="org.apache.kafka.clients.consumer.internals" level="WARN"/>
    <logger name="org.apache.kafka.clients.consumer.ConsumerConfig"   level="WARN"/>
    <logger name="org.apache.kafka.clients.producer.ProducerConfig"   level="WARN"/>
    <logger name="org.apache.kafka.clients.producer.KafkaProducer"    level="WARN"/>
    <logger name="org.apache.kafka.clients.producer.internals"        level="WARN"/>
    <logger name="org.apache.kafka.clients.admin.AdminClientConfig"   level="WARN"/>
    <logger name="org.apache.kafka.common.utils.AppInfoParser"        level="WARN"/>
    <logger name="org.apache.kafka.clients.Metadata"                  level="WARN"/>
    <logger name="org.apache.kafka.clients.NetworkClient"             level="ERROR"/>
    <logger name="org.apache.kafka.common.metrics"                   level="WARN"/>
    <logger name="org.apache.kafka.common.telemetry.internals"       level="WARN"/>
    <logger name="org.springframework.kafka.listener.KafkaMessageListenerContainer" level="WARN"/>

    <!-- Telegram long-polling transport: 502/NoHttpResponse are transient network hiccups
         that DefaultBotSession handles internally (retries). Downgrade to WARN. -->
    <logger name="org.telegram.telegrambots.updatesreceivers.DefaultBotSession" level="WARN"/>

    <!-- ═══════════════════════════════════════════════════════════════════════
         local — подробный вывод с цветами
         ═══════════════════════════════════════════════════════════════════════ -->
    <springProfile name="local">
        <!-- Valui modules -->
        <logger name="com.valui"                        level="DEBUG"/>
        <!-- Spring internals — INFO уровень для старта, не выше -->
        <logger name="org.springframework.web"          level="INFO"/>
        <logger name="org.springframework.security"     level="INFO"/>
        <logger name="org.springframework.kafka"                                         level="INFO"/>
        <logger name="org.springframework.kafka.listener.KafkaMessageListenerContainer" level="INFO"/>
        <logger name="org.hibernate"                    level="INFO"/>
        <logger name="org.hibernate.SQL"                level="DEBUG"/>
        <logger name="org.hibernate.orm.jdbc.bind"      level="TRACE"/>
        <logger name="com.zaxxer.hikari"                level="INFO"/>
        <logger name="org.apache.catalina"              level="INFO"/>
        <logger name="org.flywaydb"                     level="INFO"/>
        <!-- Netty TLS — ожидаемый RST от geo-blocked серверов (BetCity/XBet) -->
        <logger name="reactor.netty.http.client.HttpClientConnect"        level="ERROR"/>
        <logger name="io.netty.handler.ssl"                               level="ERROR"/>
        <!-- Telegram library — очень шумный на DEBUG -->
        <logger name="org.telegram"                     level="INFO"/>
        <logger name="org.apache.http"                  level="WARN"/>
        <logger name="io.lettuce"                       level="INFO"/>
        <!-- Netty DNS — некритичное предупреждение на macOS -->
        <logger name="io.netty.resolver.dns"            level="ERROR"/>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- ═══════════════════════════════════════════════════════════════════════
         docker — JSON для контейнерного сборщика логов
         ═══════════════════════════════════════════════════════════════════════ -->
    <springProfile name="docker">
        <logger name="com.valui"            level="INFO"/>
        <logger name="org.flywaydb"         level="WARN"/>
        <logger name="org.springframework"  level="WARN"/>
        <logger name="org.telegram"         level="WARN"/>
        <!-- Netty TLS — transient SSL resets from geo-blocked servers (BetCity/XBet) -->
        <logger name="reactor.netty.http.client.HttpClientConnect" level="ERROR"/>
        <logger name="io.netty.handler.ssl"                        level="ERROR"/>
        <logger name="io.netty.channel"                            level="ERROR"/>
        <!-- Reactor fatal-exception wrapper — suppressed because the wrapped OOM/OOME
             is already logged by the actual failing component at ERROR level -->
        <logger name="reactor.core.publisher.Operators"            level="ERROR"/>
        <root level="INFO">
            <appender-ref ref="ASYNC_JSON"/>
        </root>
    </springProfile>

    <!-- ═══════════════════════════════════════════════════════════════════════
         prod — цветной вывод в stdout (для tmux/journald) + параллельно чистый
         ротируемый файл на диске (для скачивания/анализа без терминала)
         ═══════════════════════════════════════════════════════════════════════ -->
    <springProfile name="prod">
        <logger name="com.valui"            level="INFO"/>
        <logger name="org.flywaydb"         level="INFO"/>
        <logger name="org.springframework"  level="WARN"/>
        <logger name="org.telegram"         level="WARN"/>
        <!-- Netty TLS — transient SSL resets from geo-blocked servers (BetCity/XBet) -->
        <logger name="reactor.netty.http.client.HttpClientConnect" level="ERROR"/>
        <logger name="io.netty.handler.ssl"                        level="ERROR"/>
        <logger name="io.netty.channel"                            level="ERROR"/>
        <!-- Reactor fatal-exception wrapper — suppressed because the wrapped OOM/OOME
             is already logged by the actual failing component at ERROR level -->
        <logger name="reactor.core.publisher.Operators"            level="ERROR"/>
        <root level="WARN">
            <appender-ref ref="ASYNC_CONSOLE"/>
            <appender-ref ref="ASYNC_FILE"/>
        </root>
    </springProfile>

    <!-- ═══════════════════════════════════════════════════════════════════════
         Fallback — нет активного профиля (unit tests и т.п.)
         ═══════════════════════════════════════════════════════════════════════ -->
    <springProfile name="!(local | docker | prod)">
        <logger name="com.valui" level="DEBUG"/>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

</configuration>
